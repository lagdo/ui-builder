{
    "name": "lagdo/ui-builder",
    "type": "library",
    "description": "A customizable and extensible HTML UI builder.",
    "authors": [
        {
            "name": "Thierry Feuzeu",
            "email": "thierry.feuzeu@gmail.com"
        }
    ],
    "homepage": "https://github.com/lagdo/ui-builder",
    "license": "MIT",
    "keywords": ["HTML", "UI", "Builder"],
    "support": {
        "issues": "https://github.com/lagdo/ui-builder/issues",
        "source": "https://github.com/lagdo/ui-builder"
    },
    "require": {
        "php": ">=8.1",
        "lagdo/html-builder": "1.6.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "php-coveralls/php-coveralls": "^2.5",
        "phpunit/phpcov": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Lagdo\\UiBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lagdo\\UiBuilder\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
